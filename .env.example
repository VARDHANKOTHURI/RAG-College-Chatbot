# ==========================================================
# RAG-Based College Chatbot — Environment Configuration
# ==========================================================

# Database Configuration (Optional: connects to local MongoDB or MongoDB Atlas; falls back to embedded storage if empty)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=college_rag_chatbot

# Security & Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Vector Database (Qdrant)
# Leave QDRANT_URL empty to use local embedded persistent Qdrant at ./data/qdrant_storage
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=college_knowledge_base
QDRANT_PATH=./data/qdrant_storage

# LLM Providers (Optional: Gemini / OpenRouter API keys; uses extractive grounded synthesis if empty)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Embeddings & RAG Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_THRESHOLD=0.28
ENABLE_RERANKING=true

# Storage & Uploads
UPLOAD_DIR=./data/uploads
STATIC_DIR=./static
MAX_UPLOAD_SIZE_MB=25
